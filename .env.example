# Spotify API Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT

# Spotify Developer Dashboard Application Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Integration Mode: 'DEMO' (offline/synthetic mock) or 'REAL' (live Spotify API)
SPOTIFY_MODE=DEMO

# Optional Refresh Token for head-less CLI / background pipelines
SPOTIFY_REFRESH_TOKEN=
